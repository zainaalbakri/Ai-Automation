    {
      "parameters": {
        "promptType": "define",
        "text": "=\nAnalyze this customer feedback:\n\n{{ $json.Feedback }}\n\nReturn strictly valid JSON as an array containing exactly one object.\n\nThe object must have these keys:\n- feedback: Original feedback text unchanged.\n- action: One specific actionable recommendation for the team, in the same language as the feedback.\n- status: Only \"positive\" or \"negative\".\n- priority: Only \"high\", \"neutral\", or \"low\".\n\nClassification rules:\n- Positive feedback: status positive, priority low.\n- Minor suggestions or complaints: status negative, priority neutral.\n- Serious issues such as payment, login, or reservation failures: status negative, priority high.\n\nSupport all languages and dialects.\nReturn raw JSON only. No markdown, no explanations.\n",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        256,
        -304
      ],
      "id": "46876757-554c-48ce-89f5-7be01b2c0c8b",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.flatMap(item => {\n  let raw = item.json.text;\n\n  // Remove Markdown formatting if present\n  raw = raw.replace(/```json|```/gi, '').trim();\n\n  // Parse AI response\n  const parsed = JSON.parse(raw);\n\n  // Return structured data\n  return parsed.map(result => ({\n    json: {\n      feedback: result.feedback,\n      action: result.action,\n      status: result.status,\n      priority: result.priority\n    }\n  }));\n});\n"
      },
